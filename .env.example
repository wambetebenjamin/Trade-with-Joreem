# Canonical production URL after DNS verification (default is the Vercel project domain)
NEXT_PUBLIC_SITE_URL=https://trade-with-joreem.vercel.app

# Supabase project — use a dedicated Trade with Joreem project
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe TEST MODE. Keep secret and webhook values server-only.
STRIPE_SECRET_KEY=
# Keep false until test purchases and legal/fulfillment checks are approved
ALLOW_LIVE_PAYMENTS=false
STRIPE_WEBHOOK_SECRET=
STRIPE_START20_COUPON_ID=
STRIPE_SHIPPING_RATE_ID=
STRIPE_AUTOMATIC_TAX=false
# Keep false until curriculum, community provisioning, legal terms and support are ready
MEMBERSHIP_DELIVERY_ENABLED=false
PRINT_FULFILLMENT_ENABLED=false
STRIPE_PRICE_FOUNDATION_MONTHLY=
STRIPE_PRICE_FOUNDATION_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_ELITE_MONTHLY=
STRIPE_PRICE_ELITE_ANNUAL=
STRIPE_PRICE_FOREX_MASTERY=
STRIPE_PRICE_CRYPTO_SIGNALS=
STRIPE_PRICE_TRADING_PSYCHOLOGY=
STRIPE_PRICE_STOCKS_FROM_ZERO=
STRIPE_PRICE_BUNDLE=

# Resend — use a verified sending domain
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_EMAIL=hello@tradewithjoreem.com

# Supabase private Storage bucket
BOOKS_BUCKET=book-files

# Optional least-privilege community bots; not needed for core checkout
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
