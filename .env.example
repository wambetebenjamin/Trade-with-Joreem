# Canonical site URL after your Render domain is confirmed
NEXT_PUBLIC_SITE_URL=https://your-render-site.onrender.com

# Google Apps Script Web App URL (replace the placeholder with the deployed /exec URL).
# The NEXT_PUBLIC value is used in browser form/data requests; keep the server value identical.
NEXT_PUBLIC_GOOGLE_SCRIPT_WEBAPP_URL=GOOGLE_SCRIPT_WEBAPP_URL
GOOGLE_SCRIPT_WEBAPP_URL=GOOGLE_SCRIPT_WEBAPP_URL
# Server-only shared secret used only for Stripe's signature-verified webhook forwarding.
# Set the same value as the Apps Script Script Property TWJ_STRIPE_WEBHOOK_SECRET.
GOOGLE_SCRIPT_WEBHOOK_SECRET=
# Optional server-only token for trusted Apps Script Docs/Slides automation
GOOGLE_SCRIPT_AUTOMATION_TOKEN=

# Stripe TEST MODE. Keep secret and webhook values server-only.
STRIPE_SECRET_KEY=
ALLOW_LIVE_PAYMENTS=false
STRIPE_WEBHOOK_SECRET=
STRIPE_START20_COUPON_ID=
STRIPE_SHIPPING_RATE_ID=
STRIPE_AUTOMATIC_TAX=false
# Remain disabled until corresponding access/delivery operations are genuinely ready.
MEMBERSHIP_DELIVERY_ENABLED=false
DIGITAL_DELIVERY_ENABLED=false
PRINT_FULFILLMENT_ENABLED=false
STRIPE_PRICE_FOUNDATION_MONTHLY=
STRIPE_PRICE_FOUNDATION_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_ELITE_MONTHLY=
STRIPE_PRICE_ELITE_ANNUAL=
STRIPE_PRICE_FOREX_MASTERY=
STRIPE_PRICE_CRYPTO_SIGNALS=
STRIPE_PRICE_TRADING_PSYCHOLOGY=
STRIPE_PRICE_STOCKS_FROM_ZERO=
STRIPE_PRICE_BUNDLE=

# Optional least-privilege community bots; not required by the Sheets integration.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
