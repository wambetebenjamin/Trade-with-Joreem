+}
+
+.plan-save {
+    display: inline-block;
+    margin-top: 10px;
+    font-size: 12px;
+    font-weight: 600;
+    color: var(--secondary);
+    background: rgba(22, 199, 132, .12);
+    border: 1px solid rgba(22, 199, 132, .35);
+    padding: 4px 12px;
+    border-radius: 100px;
+}
+
+.plan-list {
+    list-style: none;
+    padding: 0;
+    margin: 24px 0 28px;
+    flex: 1;
+}
+
+.plan-list li {
+    padding: 9px 0;
+    font-size: 14px;
+    color: #C6D3E8;
+    display: flex;
+    gap: 12px;
+    align-items: flex-start;
