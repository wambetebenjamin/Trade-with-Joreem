new file mode 100644
index 0000000..47ef74e
--- /dev/null
+++ b/css/style.css
@@ -0,0 +1,1079 @@
+/********** Trade with Joreem — Core Dark Theme **********/
+:root {
+    --primary: #F0B429;
+    --primary-dark: #D99A14;
+    --primary-soft: rgba(240, 180, 41, .13);
+    --secondary: #16C784;
+    --loss: #F6465D;
+    --light: #101D36;
+    --lighter: #0C1730;
+    --dark: #070D1A;
+    --darker: #04080F;
+    --line: rgba(148, 178, 255, .14);
+    --text: #E7EEF9;
+    --muted: #9FB0C9;
+}
+
+/*** Base ***/
+body {
+    background: var(--dark);
+    color: var(--text);
+    font-family: 'Nunito', sans-serif;
+    font-weight: 400;
+    overflow-x: hidden;
+}
+
+a {
+    color: var(--primary);
+}
+
+a:hover {
+    color: #FFC94D;
+}
+
+::selection {
+    background: var(--primary);
+    color: #0A1220;
+}
+
+::-webkit-scrollbar {
+    width: 10px;
+}
+
+::-webkit-scrollbar-track {
+    background: var(--darker);
+}
+
+::-webkit-scrollbar-thumb {
+    background: #24365E;
+    border-radius: 6px;
+}
+
+::-webkit-scrollbar-thumb:hover {
+    background: var(--primary-dark);
+}
+
+/*** Spinner ***/
+.spinner {
+    width: 44px;
+    height: 44px;
+    background: var(--primary);
+    margin: 100px auto;
+    -webkit-animation: sk-rotateplane 1.2s infinite ease-in-out;
+    animation: sk-rotateplane 1.2s infinite ease-in-out;
+    border-radius: 10px;
+}
+
+@keyframes sk-rotateplane {
+    0% { -webkit-transform: perspective(120px); }
+    50% { -webkit-transform: perspective(120px) rotateY(180deg); }
+    100% { -webkit-transform: perspective(120px) rotateY(180deg) rotateX(180deg); }
+}
+
+@keyframes sk-rotateplane2 {
+    0% { transform: rotateX(0deg) rotateY(0deg); }
+    50% { transform: rotateX(-180.1deg) rotateY(0deg); }
+    100% { transform: rotateX(-180deg) rotateY(-179.9deg); }
+}
+
+.spinner {
+    animation: sk-rotateplane2 1.2s infinite ease-in-out;
+}
+
+#spinner {
+    opacity: 0;
+    visibility: hidden;
+    transition: opacity .5s ease-out, visibility 0s linear .5s;
+    z-index: 99999;
+    background: var(--darker);
+}
+
+#spinner.show {
+    transition: opacity .5s ease-out, visibility 0s linear 0s;
+    visibility: visible;
+    opacity: 1;
+}
+
+
+/*** Heading ***/
+h1, h2, .fw-bold {
+    font-weight: 700 !important;
+    font-family: 'Rubik', sans-serif;
+    letter-spacing: -.01em;
+}
+
+h3, h4, .fw-semi-bold {
+    font-weight: 600 !important;
+    font-family: 'Rubik', sans-serif;
+}
+
+h5, h6, .fw-medium {
+    font-weight: 600 !important;
+    font-family: 'Rubik', sans-serif;
+}
+
+.mono {
+    font-family: 'JetBrains Mono', monospace;
+}
+
+
+/*** Button ***/
+.btn {
+    font-family: 'Rubik', sans-serif;
+    font-weight: 600;
+    transition: .3s;
+    border-radius: 10px;
+}
+
+.btn-primary,
+.btn-secondary {
+    color: #0A1220;
+    box-shadow: inset 0 0 0 50px transparent;
+}
+
+.btn-primary {
+    background: var(--primary);
+}
+
+.btn-primary:hover,
+.btn-primary:focus {
+    background: #FFC94D;
+    color: #0A1220;
+    transform: translateY(-2px);
+    box-shadow: inset 0 0 0 0 var(--primary), 0 12px 28px rgba(240, 180, 41, .35);
+}
+
+.btn-secondary {
+    background: var(--secondary);
+}
+
+.btn-secondary:hover {
+    background: #2BE3A0;
+    color: #06281C;
+}
+
+.btn-outline-light {
+    color: #fff;
+    border-color: rgba(255, 255, 255, .45);
+}
+
+.btn-outline-light:hover {
+    background: rgba(255, 255, 255, .12);
+    border-color: #fff;
+    color: #fff;
+    transform: translateY(-2px);
+}
+
+.btn-dark {
+    background: #0A1220;
+    color: #fff;
+    border: 1px solid rgba(255, 255, 255, .12);
+}
+
+.btn-dark:hover {
+    background: #13233F;
+    color: #fff;
+}
+
+.btn-square,
+.btn-sm-square,
+.btn-lg-square {
+    padding-left: 0;
+    padding-right: 0;
+    text-align: center;
+}
+
+.btn-square {
+    width: 36px;
+    height: 36px;
+}
+
+.btn-sm-square {
+    width: 30px;
+    height: 30px;
+}
+
+.btn-lg-square {
+    width: 48px;
+    height: 48px;
+}
+
+
+/*** Topbar ***/
+.topbar {
+    background: var(--darker);
+    border-bottom: 1px solid var(--line);
+    font-size: 13px;
+}
+
+.topbar small {
+    color: var(--muted);
+}
+
+.topbar a {
+    color: var(--muted);
+    text-decoration: none;
+    transition: .3s;
+}
+
+.topbar a:hover {
+    color: var(--primary);
+}
+
+.topbar .btn {
+    border-color: rgba(148, 178, 255, .22);
+    color: var(--muted);
+    border-radius: 50%;
+}
+
+.topbar .btn:hover {
+    color: var(--primary);
+    border-color: var(--primary);
+    background: var(--primary-soft);
+}
+
+.pulse-dot {
+    display: inline-block;
+    width: 8px;
+    height: 8px;
+    margin-right: 6px;
+    background: var(--secondary);
+    border-radius: 50%;
+    animation: pulse-glow 1.6s infinite;
+}
+
+@keyframes pulse-glow {
+    0% { box-shadow: 0 0 0 0 rgba(22, 199, 132, .6); }
+    70% { box-shadow: 0 0 0 8px rgba(22, 199, 132, 0); }
+    100% { box-shadow: 0 0 0 0 rgba(22, 199, 132, 0); }
+}
+
+
+/*** Navbar ***/
+.navbar-dark .navbar-nav .nav-link {
+    font-family: 'Rubik', sans-serif;
+    position: relative;
+    margin-left: 26px;
+    padding: 35px 0;
+    color: #D7E2F4;
+    font-size: 15px;
+    font-weight: 600;
+    letter-spacing: .02em;
+    outline: none;
+    transition: .3s;
+}
+
+.sticky-top.navbar-dark .navbar-nav .nav-link {
+    padding: 20px 0;
+    color: #D7E2F4;
+}
+
+.navbar-dark .navbar-nav .nav-link:hover,
+.navbar-dark .navbar-nav .nav-link.active {
+    color: var(--primary);
+}
+
+.navbar-dark .navbar-brand {
+    display: flex;
+    align-items: center;
+}
+
+.navbar-dark .navbar-brand .brand-mark {
+    width: 38px;
+    height: 38px;
+    margin-right: 10px;
+}
+
+.navbar-dark .navbar-brand h1 {
+    color: #FFFFFF;
+    font-size: 21px;
+    line-height: 1;
+    font-weight: 700;
+}
+
+.navbar-dark .navbar-brand h1 span {
+    color: var(--primary);
+}
+
+.navbar-dark .navbar-toggler {
+    color: var(--primary) !important;
+    border-color: var(--primary) !important;
+}
+
+@media (max-width: 991.98px) {
+    .sticky-top.navbar-dark {
+        position: relative;
+        background: var(--lighter);
+    }
+
+    .navbar-dark .navbar-nav .nav-link,
+    .navbar-dark .navbar-nav .nav-link.show,
+    .sticky-top.navbar-dark .navbar-nav .nav-link {
+        padding: 11px 0;
+        margin-left: 0;
+        color: #D7E2F4;
+    }
+
+    .navbar-dark .navbar-nav {
+        padding: 12px 22px;
+        background: var(--lighter);
+        border-radius: 14px;
+        border: 1px solid var(--line);
+    }
+
+    .navbar-dark .navbar-brand h1 {
+        color: #FFFFFF;
+    }
+}
+
+@media (min-width: 992px) {
+    .navbar-dark {
+        position: absolute;
+        width: 100%;
+        top: 0;
+        left: 0;
+        border-bottom: 1px solid rgba(255, 255, 255, .07);
+        z-index: 999;
+    }
+
+    .sticky-top.navbar-dark {
+        position: fixed;
+        background: rgba(7, 13, 26, .9);
+        -webkit-backdrop-filter: blur(14px);
+        backdrop-filter: blur(14px);
+        border-bottom: 1px solid var(--line);
+    }
+
+    .navbar-dark .navbar-nav .nav-link::before {
+        position: absolute;
+        content: "";
+        width: 0;
+        height: 2px;
+        bottom: 14px;
+        left: 50%;
+        background: var(--primary);
+        border-radius: 2px;
+        transition: .3s;
+    }
+
+    .navbar-dark .navbar-nav .nav-link:hover::before,
+    .navbar-dark .navbar-nav .nav-link.active::before {
+        width: 100%;
+        left: 0;
+    }
+
+    .navbar-dark .navbar-nav .nav-link.nav-contact::before {
+        display: none;
+    }
+
+    .sticky-top.navbar-dark .navbar-brand h1 {
+        color: #FFFFFF;
+    }
+}
+
+
+/*** Carousel ***/
+.carousel-caption {
+    top: 0;
+    left: 0;
+    right: 0;
+    bottom: 0;
+    background: rgba(4, 8, 15, .72);
+    z-index: 1;
+}
+
+@media (max-width: 576px) {
+    .carousel-caption h5 {
+        font-size: 14px;
