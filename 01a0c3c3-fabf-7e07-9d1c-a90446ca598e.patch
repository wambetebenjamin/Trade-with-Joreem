+    color: var(--secondary);
+    border: 1px solid rgba(22, 199, 132, .4);
+}
+
+.format-badge.print {
+    background: var(--primary-soft);
+    color: var(--primary);
+    border: 1px solid rgba(240, 180, 41, .4);
+}
+
+.book-body {
+    padding: 22px 24px 24px;
+    display: flex;
+    flex-direction: column;
+    flex: 1;
+}
+
+.book-body h4 {
+    font-size: 1.12rem;
+    margin-bottom: 8px;
+    color: #fff;
+}
+
+.book-body .desc {
