+
+    /* ================= Member auth (demo) ================= */
+    function getAuth() {
+        try { return JSON.parse(localStorage.getItem("twj_auth") || "null"); } catch (e) { return null; }
+    }
+
+    function initAuth() {
+        var loginForm = document.getElementById("loginForm");
+        if (loginForm) {
