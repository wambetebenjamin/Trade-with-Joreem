+.terminal {
+    background: linear-gradient(160deg, rgba(16, 29, 54, .92), rgba(9, 17, 33, .95));
+    border: 1px solid rgba(240, 180, 41, .25);
+    border-radius: 18px;
+    box-shadow: 0 40px 90px rgba(2, 6, 14, .65), 0 0 0 1px rgba(2, 6, 14, .4), 0 0 60px rgba(240, 180, 41, .08);
+    -webkit-backdrop-filter: blur(8px);
+    backdrop-filter: blur(8px);
+    overflow: hidden;
+    transform: perspective(1400px) rotateY(-6deg) rotateX(2deg);
+    transition: transform .5s;
+}
+
+.terminal:hover {
+    transform: perspective(1400px) rotateY(-2deg) rotateX(1deg);
+}
+
+@media (max-width: 991.98px) {
+    .terminal {
+        transform: none;
+        margin-top: 10px;
+    }
+}
+
+.terminal-head {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    gap: 10px;
+    padding: 14px 18px;
+    border-bottom: 1px solid var(--line);
+    background: rgba(4, 8, 15, .5);
+}
+
+.terminal-dots {
+    display: flex;
+    gap: 6px;
+}
+
+.terminal-dots span {
+    width: 10px;
+    height: 10px;
+    border-radius: 50%;
+    background: #24365E;
+}
+
+.terminal-dots span:nth-child(1) { background: rgba(246, 70, 93, .8); }
+.terminal-dots span:nth-child(2) { background: rgba(240, 180, 41, .8); }
+.terminal-dots span:nth-child(3) { background: rgba(22, 199, 132, .8); }
+
+.terminal-pair {
+    font-family: 'JetBrains Mono', monospace;
+    font-size: 13px;
+    font-weight: 700;
+    color: #fff;
+    display: flex;
+    align-items: center;
+    gap: 8px;
+}
+
+.terminal-pair .live {
+    font-size: 10px;
+    letter-spacing: .12em;
+    color: var(--secondary);
+    border: 1px solid rgba(22, 199, 132, .4);
+    background: rgba(22, 199, 132, .1);
+    padding: 2px 8px;
+    border-radius: 100px;
+}
+
+.terminal-time {
+    font-family: 'JetBrains Mono', monospace;
+    font-size: 11px;
+    color: var(--muted);
+}
+
+.terminal-price-row {
+    display: flex;
+    align-items: baseline;
+    gap: 12px;
+    padding: 16px 18px 4px;
+}
+
+.terminal-price {
+    font-family: 'JetBrains Mono', monospace;
+    font-size: 30px;
+    font-weight: 700;
+    color: #fff;
+    letter-spacing: -.01em;
+}
+
+.terminal-chg {
+    font-family: 'JetBrains Mono', monospace;
+    font-size: 13px;
+    font-weight: 700;
+    padding: 3px 10px;
+    border-radius: 8px;
+}
+
+.terminal-chg.up {
+    color: var(--secondary);
+    background: rgba(22, 199, 132, .12);
+}
+
+.terminal-chg.down {
+    color: var(--loss);
+    background: rgba(246, 70, 93, .12);
+}
+
+.candle-wrap {
+    padding: 6px 10px 4px;
+}
+
+.candle-canvas {
+    width: 100%;
+    height: 240px;
+    display: block;
+}
+
+@media (max-width: 575.98px) {
+    .candle-canvas { height: 190px; }
+    .terminal-price { font-size: 24px; }
+}
+
+.ohlc-row {
+    display: flex;
+    flex-wrap: wrap;
+    gap: 8px 18px;
+    padding: 10px 18px;
+    font-family: 'JetBrains Mono', monospace;
+    font-size: 11.5px;
+    color: var(--muted);
+    border-top: 1px solid var(--line);
+    margin-top: 6px;
+}
+
+.ohlc-row b {
+    color: #C6D3E8;
+    font-weight: 700;
+}
+
+.term-stats {
+    display: grid;
+    grid-template-columns: repeat(3, 1fr);
+    border-top: 1px solid var(--line);
+}
+
+.term-stat {
+    padding: 14px 18px;
+    border-right: 1px solid var(--line);
+}
+
+.term-stat:last-child {
+    border-right: 0;
+}
+
+.term-stat .lbl {
+    font-size: 10.5px;
+    letter-spacing: .14em;
+    text-transform: uppercase;
+    color: #5F7194;
+    margin-bottom: 4px;
+}
+
+.term-stat .val {
+    font-family: 'JetBrains Mono', monospace;
+    font-size: 14.5px;
+    font-weight: 700;
+    color: #fff;
+}
+
+.term-stat .val.green { color: var(--secondary); }
+.term-stat .val.gold { color: var(--primary); }
+
+/* Floating chips over terminal */
+.float-chip {
+    position: absolute;
+    background: rgba(9, 17, 33, .9);
+    border: 1px solid var(--line);
+    border-radius: 14px;
+    padding: 10px 16px;
+    font-family: 'JetBrains Mono', monospace;
+    font-size: 12px;
+    display: flex;
+    align-items: center;
+    gap: 8px;
+    box-shadow: 0 18px 40px rgba(2, 6, 14, .5);
+    animation: floaty 5s ease-in-out infinite;
+    z-index: 2;
+}
+
+.float-chip b {
+    color: #fff;
+}
+
+.float-chip .up { color: var(--secondary); }
+.float-chip .down { color: var(--loss); }
+
+.fc-1 { top: -22px; right: 8%; }
+.fc-2 { bottom: 90px; left: -26px; animation-delay: 1.2s; }
+
+@keyframes floaty {
+    0%, 100% { transform: translateY(0); }
+    50% { transform: translateY(-10px); }
+}
+
+@media (max-width: 991.98px) {
+    .fc-2 { left: 8px; }
+}
+
+/* ============ Mentor split ============ */
+.mentor-frame {
+    position: relative;
+    max-width: 420px;
+}
+
+.mentor-frame img {
+    width: 100%;
+    border-radius: 20px;
+    display: block;
+    border: 1px solid var(--line);
+}
+
+.mentor-frame::before {
+    content: "";
+    position: absolute;
+    inset: 22px -22px -22px 22px;
+    border: 2px solid rgba(240, 180, 41, .4);
+    border-radius: 20px;
+    z-index: 0;
+}
+
+.mentor-frame > img {
+    position: relative;
+    z-index: 1;
+}
+
+.mentor-badge {
+    position: absolute;
+    z-index: 2;
+    bottom: -20px;
+    left: -18px;
+    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
+    color: #0A1220;
+    border-radius: 16px;
+    padding: 14px 20px;
+    box-shadow: 0 18px 40px rgba(240, 180, 41, .3);
+    font-family: 'Rubik', sans-serif;
+}
+
+.mentor-badge .num {
+    font-size: 1.5rem;
+    font-weight: 700;
+    line-height: 1;
+}
+
+.mentor-badge .cap {
+    font-size: 11.5px;
+    font-weight: 600;
+    letter-spacing: .04em;
+}
+
+.check-list {
+    list-style: none;
+    padding: 0;
+    margin: 0 0 10px;
+}
+
+.check-list li {
+    padding: 9px 0;
+    color: #C6D3E8;
+    display: flex;
+    align-items: center;
+    gap: 12px;
+}
+
+.check-list li i {
+    color: var(--primary);
+    font-size: 15px;
+    width: 26px;
+    height: 26px;
+    flex-shrink: 0;
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    background: var(--primary-soft);
+    border-radius: 8px;
+}
+
+/* ============ Book cards ============ */
+.book-card {
+    background: var(--light);
+    border: 1px solid var(--line);
+    border-radius: 18px;
+    overflow: hidden;
+    transition: .4s;
+    height: 100%;
+    display: flex;
+    flex-direction: column;
+}
+
+.book-card:hover {
+    transform: translateY(-8px);
+    border-color: rgba(240, 180, 41, .5);
+    box-shadow: 0 26px 55px rgba(2, 6, 14, .6), 0 0 0 1px rgba(240, 180, 41, .12);
+}
+
+.book-cover-wrap {
+    position: relative;
+    background: radial-gradient(340px 220px at 50% 20%, rgba(240, 180, 41, .12), transparent 70%), #0A1526;
+    padding: 34px 40px 26px;
