+                });
+            }, 300);
+        }
+
+        var logoutBtn = document.getElementById("dashLogout");
+        if (logoutBtn) logoutBtn.addEventListener("click", function () {
+            localStorage.removeItem("twj_auth");
+            window.location.href = "login.html";
+        });
+    }
+
+    /* ================= Contact form (demo) ================= */
