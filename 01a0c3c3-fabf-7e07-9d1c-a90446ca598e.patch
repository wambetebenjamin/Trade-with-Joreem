+    display: inline-flex;
+    align-items: center;
+    gap: 8px;
+}
+
+.btn-cart:hover {
+    background: #FFC94D;
+    transform: translateY(-2px);
+    box-shadow: 0 10px 24px rgba(240, 180, 41, .35);
+}
+
+.btn-cart.added {
+    background: var(--secondary);
+}
+
+/* ============ Pricing plans ============ */
+.plan-card {
+    background: var(--light);
+    border: 1px solid var(--line);
+    border-radius: 20px;
+    padding: 36px 30px 30px;
