+}
+
+.pay-badge i {
+    color: var(--primary);
+}
+
+.pay-badge:hover {
+    border-color: rgba(240, 180, 41, .45);
+    transform: translateY(-2px);
+}
+
+.pay-badges {
+    display: flex;
+    flex-wrap: wrap;
+    gap: 12px;
+}
+
+/* ============ Risk band ============ */
+.risk-band {
+    background: linear-gradient(90deg, rgba(246, 70, 93, .08), rgba(240, 180, 41, .07));
+    border-top: 1px solid rgba(246, 70, 93, .25);
