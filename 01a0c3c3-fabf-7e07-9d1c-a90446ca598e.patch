+
+.book-price small {
+    font-size: 11px;
+    color: #5F7194;
+    display: block;
+    font-family: 'Nunito', sans-serif;
+    font-weight: 500;
+}
+
+.btn-cart {
+    background: var(--primary);
+    color: #0A1220;
+    border: none;
+    border-radius: 10px;
+    font-weight: 600;
+    font-family: 'Rubik', sans-serif;
+    padding: 10px 18px;
+    font-size: 14px;
