+}
+
+.plan-list li:last-child {
+    border-bottom: 0;
+}
+
+.plan-list li i {
+    color: var(--primary);
+    margin-top: 3px;
+    font-size: 13px;
+}
+
+.plan-list li.dim {
+    color: #5F7194;
+    text-decoration: line-through;
+}
+
+.plan-list li.dim i {
+    color: #5F7194;
+}
+
+/* ============ Steps (how it works) ============ */
+.step-card {
+    position: relative;
+    text-align: center;
+    padding: 26px 20px;
+}
+
+.step-num {
+    width: 64px;
+    height: 64px;
+    margin: 0 auto 18px;
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    border-radius: 18px;
+    background: var(--light);
+    border: 1px solid rgba(240, 180, 41, .4);
+    font-family: 'JetBrains Mono', monospace;
+    font-size: 1.4rem;
+    font-weight: 700;
